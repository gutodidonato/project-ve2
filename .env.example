# Public origin of the deployed site, without a trailing slash (https://example.com, not https://example.com/).
# Feeds the canonical / hreflang / Open Graph URLs, the sitemap and robots.txt. Blank uses the default Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Contact form (Resend). The API answers 503 until RESEND_API_KEY and CONTACT_TO_EMAIL are both set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender. Blank uses onboarding@resend.dev, which only delivers to the Resend account owner:
# production needs a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL=
