# Nginx server block for the portfolio, beside whatever else the VPS serves. Replace example.com and the port (PORT in
# scripts/deploy-vps.sh), save as /etc/nginx/sites-available/portfolio, link it into sites-enabled, `nginx -t && systemctl reload nginx`,
# then `certbot --nginx -d example.com -d www.example.com` for HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    client_max_body_size 2m;

    # Next's hashed build files never change under the same name
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3010;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
